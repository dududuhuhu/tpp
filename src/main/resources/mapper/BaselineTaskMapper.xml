<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tpp.threat_perception_platform.dao.BaselineTaskMapper">

    <resultMap id="BaseResultMap" type="com.tpp.threat_perception_platform.pojo.BaselineTask">
            <id property="id" column="id" />
            <result property="taskName" column="task_name" />
            <result property="taskTime" column="task_time" />
            <result property="taskStatus" column="task_status" />
            <result property="taskHosts" column="task_hosts" />
    </resultMap>

    <sql id="Base_Column_List">
        id,task_name,task_time,task_status,task_hosts
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from baseline_task
        where  id = #{id} 
    </select>
    <select id="findAll" resultType="com.tpp.threat_perception_platform.pojo.BaselineTask">
        select
        <include refid="Base_Column_List" />
        from baseline_task
        <where>
            <if test="param.keywords != null and param.keywords != ''">
                and task_hosts =#{param.keywords}
            </if>
        </where>
        order by id
    </select>
    <select id="selectByName" resultType="com.tpp.threat_perception_platform.pojo.BaselineTask">
        select
        <include refid="Base_Column_List" />
        from baseline_task
        where task_name=#{taskName}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from baseline_task
        where  id = #{id} 
    </delete>
    <delete id="delete">
        delete from baseline_task
        where  id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.tpp.threat_perception_platform.pojo.BaselineTask" useGeneratedKeys="true">
        insert into baseline_task
        ( id,task_name,task_time,task_status,task_hosts)
        values (#{id},#{taskName},#{taskTime},#{taskStatus},#{taskHosts})
    </insert>
    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.tpp.threat_perception_platform.pojo.BaselineTask" useGeneratedKeys="true">
        insert into baseline_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="taskName != null">task_name,</if>
                <if test="taskTime != null">task_time,</if>
                <if test="taskStatus != null">task_status,</if>
                <if test="taskHosts != null">task_hosts,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="taskName != null">#{taskName},</if>
                <if test="taskTime != null">#{taskTime},</if>
                <if test="taskStatus != null">#{taskStatus},</if>
                <if test="taskHosts != null">#{taskHosts},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="com.tpp.threat_perception_platform.pojo.BaselineTask">
        update baseline_task
        <set>
                <if test="taskName != null">
                    task_name = #{taskName},
                </if>
                <if test="taskTime != null">
                    task_time = #{taskTime},
                </if>
                <if test="taskStatus != null">
                    task_status = #{taskStatus},
                </if>
                <if test="taskHosts != null">
                    task_hosts = #{taskHosts},
                </if>
        </set>
        where   id = #{id} 
    </update>
    <update id="updateByPrimaryKey" parameterType="com.tpp.threat_perception_platform.pojo.BaselineTask">
        update baseline_task
        set 
            task_name =  #{taskName},
            task_time =  #{taskTime},
            task_status =  #{taskStatus},
            task_hosts =  #{taskHosts}
        where   id = #{id} 
    </update>
</mapper>
